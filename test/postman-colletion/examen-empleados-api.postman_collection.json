      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Parse the JSON response body\nvar jsonData = pm.response.json();\n\n// Set the access_token in the environment variable if it exists\nif (jsonData.access_token) {\n    pm.environment.set(\"amin_token\", jsonData.token);\n    pm.environment.set(\"access_token\", jsonData.access_token);\n}"
            ]
          }
        }
      ],
